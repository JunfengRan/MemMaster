{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-env.local/schemas/replay-chain.schema.json",
  "title": "ResearchReplayChain",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "recordedAt",
          "phase",
          "nextPhase",
          "workflowId",
          "schemaVersion",
          "nodeVersion",
          "contextPackSnapshot",
          "contextPackSha256",
          "artifacts",
          "gate",
          "gateResult"
        ],
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "recordedAt": { "type": "string", "format": "date-time" },
          "phase": { "type": "string", "minLength": 1 },
          "nextPhase": { "type": "string", "minLength": 1 },
          "workflowId": { "type": "string", "minLength": 1 },
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "nodeVersion": { "type": "string", "minLength": 1 },
          "contextPackSnapshot": { "type": "string", "minLength": 1 },
          "contextPackSha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          },
          "gate": { "type": "string", "minLength": 1 },
          "gateResult": { "enum": ["pass", "fail"] }
        }
      }
    }
  }
}
